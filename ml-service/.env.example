# Salin menjadi .env lalu isi. Berkas .env TIDAK boleh masuk repositori.
# Wajib. Tanpa API_KEY semua endpoint selain /v1/health menjawab 401.
API_KEY=ganti-dengan-kunci-acak
MODEL_PATH=models/model.joblib
# true = endpoint prediksi menjawab angka tiruan selama model belum ada.
# Di Render isi false begitu models/model.joblib sudah di-commit.
ALLOW_STUB=true
