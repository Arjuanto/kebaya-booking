PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/kebaya
# Buat acak, mis: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
# Layanan model (kontrak 5). Kalau tidak bisa dihubungi, cek ketersediaan tetap jalan tanpa perkiraan ukuran.
ML_SERVICE_URL=http://localhost:8000
# Sama dengan API_KEY di layanan model
ML_API_KEY=
ML_TIMEOUT_MS=10000
# Masa sewa (kontrak 2.4), dalam hari: useDate - RENTAL_DAYS_BEFORE s.d. useDate + RENTAL_DAYS_AFTER + LAUNDRY_DAYS
RENTAL_DAYS_BEFORE=1
RENTAL_DAYS_AFTER=1
LAUNDRY_DAYS=2
